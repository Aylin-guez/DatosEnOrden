[Unit]
Description=DatosEnOrden Reflex app
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=datosenorden
Group=datosenorden
WorkingDirectory=/opt/datosenorden/current
EnvironmentFile=/etc/datosenorden/beta.env
Environment=PATH=/opt/datosenorden/current/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=REFLEX_WEB_WORKDIR=/opt/datosenorden/current/.web
Environment=REFLEX_STATES_WORKDIR=/var/lib/datosenorden/reflex-states
Environment=REFLEX_CHECK_LATEST_VERSION=false
Environment=HOME=/var/lib/datosenorden
StateDirectory=datosenorden
StateDirectoryMode=0750
ExecStart=/opt/datosenorden/current/.venv/bin/reflex run --env prod --backend-only --backend-port 3000 --backend-host 127.0.0.1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=datosenorden

[Install]
WantedBy=multi-user.target
