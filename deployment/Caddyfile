# Assumes:
# - DATOSENORDEN_PUBLIC_BASE_URL matches the hostname in use.
# - API_URL / REFLEX_API_URL matches the same hostname.
# - REFLEX_BACKEND_PATH=/api in /opt/datosenorden/.env.
# - PREPARE exports the immutable frontend to current/.web/build/client.
# - Reflex runs backend-only on 127.0.0.1:3000.
# - API and WebSocket stay under /api on that private backend.
# Caddy handles WebSocket upgrades automatically inside reverse_proxy.

(datosenorden_common) {
    encode gzip zstd
    header {
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https: wss:"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-Frame-Options "SAMEORIGIN"
    }
    @reflex_backend path /api /api/*
    handle @reflex_backend {
        reverse_proxy 127.0.0.1:3000
    }
    handle {
        root * /opt/datosenorden/current/.web/build/client
        try_files {path} /index.html
        file_server
    }
}

beta.datosenorden.cl {
    import datosenorden_common
}
