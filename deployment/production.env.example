# Beta production-mode template. Keep the real file outside every release at
# /etc/datosenorden/beta.env with root:datosenorden ownership and mode 0640.
# REQUIRED_SECRET: DATABASE_URL, DATOSENORDEN_DATABASE_URL.
# REQUIRED_PUBLIC: DATOSENORDEN_ENV, DATOSENORDEN_PUBLIC_BASE_URL, API_URL.
# OPTIONAL: DATOSENORDEN_SUPPORT_URL, REFLEX_BACKEND_PATH, DATOSENORDEN_LOG_LEVEL.
# DERIVED: canonical public URL and backend path are validated by production_config.
# DNS is intentionally not implied by this template.

DATOSENORDEN_ENV=production
DATOSENORDEN_PUBLIC_BASE_URL=https://beta.datosenorden.cl
DATOSENORDEN_SUPPORT_URL=https://link.mercadopago.cl/datosenorden
DATABASE_URL=postgresql+psycopg://datosenorden_beta:REQUIRED_SECRET@127.0.0.1:5432/datosenorden_beta
DATOSENORDEN_DATABASE_URL=postgresql+psycopg://datosenorden_beta:REQUIRED_SECRET@127.0.0.1:5432/datosenorden_beta
DATOSENORDEN_DEBUG_INVESTIGATION=0

# Reflex self-hosting behind Caddy.
API_URL=https://beta.datosenorden.cl
REFLEX_API_URL=https://beta.datosenorden.cl
REFLEX_BACKEND_PATH=/api
DATOSENORDEN_LOG_LEVEL=INFO
