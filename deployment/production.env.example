# Production template for datosenorden.cl or beta.datosenorden.cl
# Never commit the real .env file.
# Replace every CHANGE_ME value before first boot.
# PostgreSQL must stay private on localhost or behind a private network.

DATOSENORDEN_ENV=production
DATOSENORDEN_PUBLIC_BASE_URL=https://datosenorden.cl
DATOSENORDEN_SUPPORT_URL=https://link.mercadopago.cl/datosenorden
DATABASE_URL=postgresql+psycopg://USERNAME:REQUIRED_SECRET@PRIVATE_DB_HOST:5432/datosenorden
DATOSENORDEN_DATABASE_URL=postgresql+psycopg://USERNAME:REQUIRED_SECRET@PRIVATE_DB_HOST:5432/datosenorden
DATOSENORDEN_DEBUG_INVESTIGATION=0

# Reflex self-hosting behind Caddy.
# For beta, change both URLs to https://beta.datosenorden.cl before starting the service.
API_URL=https://datosenorden.cl
REFLEX_API_URL=https://datosenorden.cl
REFLEX_BACKEND_PATH=/api
DATOSENORDEN_LOG_LEVEL=INFO
