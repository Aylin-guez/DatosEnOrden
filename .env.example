DATOSENORDEN_ENV=production
DATOSENORDEN_PUBLIC_BASE_URL=https://datosenorden.cl
DATOSENORDEN_SUPPORT_URL=https://link.mercadopago.cl/datosenorden
# Preferred by the app and Alembic.
DATABASE_URL=postgresql+psycopg://username:password@db-host:5432/datosenorden

# Backward-compatible alias.
DATOSENORDEN_DATABASE_URL=postgresql+psycopg://username:password@db-host:5432/datosenorden

# Keep disabled in public unless diagnosing a temporary issue.
DATOSENORDEN_DEBUG_INVESTIGATION=0
